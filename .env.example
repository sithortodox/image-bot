# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
